# ---------------------------------------------------------------------------
# MONOLITH — Streetwear store
# Copy this file to .env and replace every placeholder with a real value.
# NEVER commit your real .env file.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
# Port the Express API listens on (assigned by the deploy script).
PORT=4118
# Node environment: development | production
NODE_ENV=development

# --- TLS (the API can terminate HTTPS itself) ------------------------------
# Set to 'true' to serve HTTPS directly from the Node process.
SSL_ENABLED=false
# Absolute path to the TLS certificate file (required when SSL_ENABLED=true).
SSL_CERT_PATH=/home/arx-app/backends/certs/certificate.crt
# Absolute path to the TLS private key file (required when SSL_ENABLED=true).
SSL_KEY_PATH=/home/arx-app/backends/certs/private.key
# Optional absolute path to a CA chain bundle. Leave empty if not used.
SSL_CA_PATH=

# --- MySQL -----------------------------------------------------------------
DB_HOST=localhost
DB_USER=clothing_user
DB_PASSWORD=replace-with-your-db-password
DB_NAME=clothing

# --- Session / cookies -----------------------------------------------------
# Long random string used to sign the session cookie.
SESSION_SECRET=replace-with-a-long-random-session-secret
# Cookie domain shared by the frontend and API hosts, e.g. .arx-app.com
# Leave empty for local development on localhost.
SESSION_COOKIE_DOMAIN=

# --- CORS ------------------------------------------------------------------
# Comma separated list of EXTRA allowed browser origins.
# All https?://*.arx-app.com hosts and localhost dev ports are always allowed.
CORS_ORIGINS=http://localhost:3000

# --- Frontend --------------------------------------------------------------
# Base URL of the API as reached from the browser (exposed to client code).
NEXT_PUBLIC_API_BASE_URL=https://clothing-api.arx-app.com:4118

# ---------------------------------------------------------------------------
# Payment providers (server side only — never expose these to the browser).
# Leave a provider's keys blank to hide it from /api/payments/providers.
# All amounts are charged in USD.
# ---------------------------------------------------------------------------

# --- Stripe ----------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_placeholder_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_stripe_webhook_secret

# --- PayPal ----------------------------------------------------------------
PAYPAL_CLIENT_ID=placeholder_paypal_client_id
PAYPAL_CLIENT_SECRET=placeholder_paypal_client_secret

# --- Paystack --------------------------------------------------------------
PAYSTACK_SECRET_KEY=sk_test_placeholder_paystack_secret_key

# --- Flutterwave -----------------------------------------------------------
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-placeholder-flutterwave-secret-key
FLUTTERWAVE_WEBHOOK_HASH=placeholder_flutterwave_webhook_hash